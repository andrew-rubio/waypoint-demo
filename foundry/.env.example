# Foundry hosted-agent env (INC-9, ADR-010). Values set via `azd env set` in the
# `foundry/` azd project before `azd deploy`. Secrets never go here — managed
# identity only (ADR-005). Auto-injected in hosted containers: FOUNDRY_PROJECT_ENDPOINT,
# AZURE_AI_MODEL_DEPLOYMENT_NAME, APPLICATIONINSIGHTS_CONNECTION_STRING.

# Existing Foundry project (from the main ACA deploy — rg-waypoint, swedencentral).
AZURE_SUBSCRIPTION_ID=c7233dbc-6a6d-40da-83a7-738e54ffedef
AZURE_LOCATION=swedencentral
AZURE_AI_PROJECT_ENDPOINT=https://aif-dnszpz4hqfi7g.services.ai.azure.com/api/projects/waypoint

# Model deployment name (Foundry) — must match the ai-project deployment above.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# OpenAI-compatible base URL for the Copilot SDK BYOK driver (ADR-005).
# Resolved from the provisioned AIServices account (aif-dnszpz4hqfi7g).
FOUNDRY_MODEL_URL=https://aif-dnszpz4hqfi7g.openai.azure.com/openai/v1/
