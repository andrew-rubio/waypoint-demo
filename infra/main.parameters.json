{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "copilotGitHubToken": {
      "value": "${COPILOT_GITHUB_TOKEN}"
    },
    "routestackApiKey": {
      "value": "${ROUTESTACK_API_KEY}"
    },
    "routestackSecret": {
      "value": "${ROUTESTACK_SECRET}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployFoundryPtu": {
      "value": "${DEPLOY_FOUNDRY_PTU=false}"
    },
    "useFoundryPtu": {
      "value": "${USE_FOUNDRY_PTU=false}"
    },
    "foundryAgentResponsesUrl": {
      "value": "${FOUNDRY_AGENT_RESPONSES_URL}"
    }
  }
}
