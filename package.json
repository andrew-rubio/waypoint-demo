{
  "name": "waypoint",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["src/shared", "src/api", "src/web", "src/mcp", "src/governance"],
  "scripts": {
    "test": "npm run test:unit && npm run test:bdd && npm run test:e2e",
    "test:unit": "vitest run --config src/api/vitest.config.ts",
    "test:unit:watch": "vitest --config src/api/vitest.config.ts",
    "test:bdd": "cross-env NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:gov": "vitest run --config src/governance/vitest.config.ts",
    "eval:dataset": "node eval/generate-dataset.mjs",
    "eval:run-agent": "node eval/run-agent.mjs",
    "eval:demo-fail": "node scripts/eval-demo.mjs fail",
    "eval:demo-pass": "node scripts/eval-demo.mjs pass",
    "gov": "tsx src/governance/src/cli.ts",
    "gov:select": "tsx src/governance/src/cli.ts select",
    "gov:contract": "tsx src/governance/src/cli.ts contract",
    "gov:approve": "tsx src/governance/src/cli.ts approve",
    "gov:evidence": "tsx src/governance/src/cli.ts evidence",
    "gov:verify": "tsx src/governance/src/cli.ts verify",
    "gov:certify": "tsx src/governance/src/cli.ts certify",
    "gov:dossier": "tsx src/governance/src/cli.ts dossier",
    "gov:status": "tsx src/governance/src/cli.ts status",
    "gov:trace": "tsx src/governance/src/cli.ts trace",
    "gov:change-impact": "tsx src/governance/src/cli.ts change-impact",
    "gov:learn": "tsx src/governance/src/cli.ts learn",
    "gov:demo-failure": "tsx src/governance/src/cli.ts demo-failure",
    "gov:demo-pass": "tsx src/governance/src/cli.ts demo-pass",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "build": "npm -ws --if-present run build",
    "lint": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
